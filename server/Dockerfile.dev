# syntax=docker/dockerfile:1.7
# Sermon Translate API DEV image — uvicorn --reload, source bind-mounted at runtime.
# Production image remains Dockerfile. Heavy optional ML wheels are skipped so the
# HTTP surface can boot without a real ../../seamless_communication checkout.
#
# WORKDIR is /opt/src so the lockfile path ../../seamless_communication can be
# normalized (uv --no-install-package then skips that missing tree).

FROM python:3.12-slim-bookworm

COPY --from=ghcr.io/astral-sh/uv:0.11.3 /uv /usr/local/bin/uv

ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_CACHE_DIR=/opt/uv-cache \
    UV_LINK_MODE=copy \
    PATH=/opt/venv/bin:/usr/local/bin:$PATH \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /opt/src

COPY pyproject.toml uv.lock ./
COPY docker-entrypoint.dev.sh /usr/local/bin/sermon-translate-api-dev-entrypoint
COPY docker-uv-sync-dev.sh /usr/local/bin/docker-uv-sync-dev.sh
RUN chmod +x /usr/local/bin/sermon-translate-api-dev-entrypoint \
             /usr/local/bin/docker-uv-sync-dev.sh \
 && mkdir -p /opt/venv /opt/uv-cache \
 && /usr/local/bin/docker-uv-sync-dev.sh

EXPOSE 8000
ENTRYPOINT ["/usr/local/bin/sermon-translate-api-dev-entrypoint"]
CMD ["uvicorn", "src.main:app", "--reload", "--reload-dir", "/opt/src/src", "--host", "0.0.0.0", "--port", "8000"]
